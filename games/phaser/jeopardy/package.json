{
  "private": true,
  "name": "jeopardy-devvit",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run type-check && npm run lint",
    "deploy": "npm run check && devvit upload",
    "dev": "dotenv -e .env -- devvit playtest",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "login": "devvit login --copy-paste",
    "launch": "npm run check && devvit publish",
    "prettier": "prettier-package-json --write ./package.json && prettier --write .",
    "type-check": "tsc --build",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@devvit/web": "0.14.2",
    "cheerio": "^1.2.0",
    "express": "5.2.1",
    "phaser": "3.88.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "dotenv-cli": "11.0.0",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-package-json": "2.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "devvit": "0.14.2",
    "@devvit/start": "0.14.2",
    "@types/node": "24.13.3"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
